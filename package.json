{
  "name": "vim-copilot-canvas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "version:release": "changeset version && node scripts/release-metadata.mjs sync && npm install --package-lock-only --ignore-scripts && npm run build",
    "release:check": "node scripts/release-metadata.mjs check",
    "release": "npm run build:check && changeset publish",
    "build": "node scripts/build.mjs",
    "build:check": "npm run build && node scripts/check-assets.mjs",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:browser": "vitest run --project browser",
    "test:e2e": "npm run build && vitest run --project e2e",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@primer/css": "22.3.2",
    "@primer/primitives": "11.10.0",
    "@replit/codemirror-vim": "6.4.0",
    "codemirror": "6.0.2",
    "marked": "18.1.1",
    "marked-alert": "2.1.2",
    "marked-footnote": "1.4.0",
    "marked-gfm-heading-id": "4.1.4",
    "xss": "1.0.15"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@vitest/browser-playwright": "5.0.4",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "vitest": "5.0.4"
  }
}
