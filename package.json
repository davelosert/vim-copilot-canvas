{
  "name": "vim-copilot-canvas",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/frontend/main.js --bundle --format=esm --splitting --outdir=assets --entry-names=editor --chunk-names=chunks/[name]-[hash] --minify",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:browser": "vitest run --project browser",
    "test:e2e": "npm run build && vitest run --project e2e",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@replit/codemirror-vim": "6.4.0",
    "codemirror": "6.0.2",
    "marked": "18.1.1",
    "marked-alert": "2.1.2",
    "marked-footnote": "1.4.0",
    "marked-gfm-heading-id": "4.1.4",
    "xss": "1.0.15"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.4",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "vitest": "5.0.4"
  }
}
